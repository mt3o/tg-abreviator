{
  "name": "tg-abreviator",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot that summarizes a group chat, or answers questions about it, over a user-selected range of messages.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "targetRuntime": "Node 26 (DESIGN 3). Temporal is consumed through temporal-polyfill via src/domain/time/temporal.ts, so the toolchain also runs on Node 22 LTS.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:boundaries-fixture": "node eslint-fixtures/verify.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@sentry/node": "^10.75.0",
    "better-sqlite3": "^13.0.3",
    "config-layers": "^0.4.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0",
    "pino": "^10.3.1",
    "proper-lockfile": "^4.1.2",
    "temporal-polyfill": "^1.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.1",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^5.0.1",
    "diff": "^9.0.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
