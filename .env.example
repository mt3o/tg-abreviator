# Copy to .env and fill in. .env is git-ignored (DESIGN §10: secrets are
# env-only, config.yaml is in git and must never hold them).
#
# Used by docker-compose.yml (env_file) and by `npm run dev` / a bare `node`
# invocation outside Docker alike.

# From @BotFather. Required.
BOT_TOKEN=

# Required for every model in config.yaml whose registry entry names this as
# its apiKeyEnv (config.example.yaml ships both aliases on this one key).
ANTHROPIC_API_KEY=

# Comma-separated Telegram user ids. Tier `operator`: allowed anywhere,
# including chats outside the allowlist for administration. Leave empty and
# nobody has that tier.
OPERATOR_USER_IDS=

# GlitchTip DSN. Leave unset/empty to use the no-op error reporter — the bot
# runs fine without one, and tests never emit regardless (DESIGN §11).
GLITCHTIP_DSN=

# Ceiling that retention.ttlDays / retention.perChatTtlDays in config.yaml
# may never exceed. Uncomment to enforce one from the deployment side
# regardless of what config.yaml says.
# TTL_HARD_CAP_DAYS=90
